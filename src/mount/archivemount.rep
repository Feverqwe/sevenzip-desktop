#include <QList>
#include <QByteArray>

POD MountTreeEntry(quint64 id, quint64 parent, quint64 size, quint64 modified, QString name, bool directory, bool childrenLoaded, QString symlinkTarget)
POD MountTreeRead(quint32 result, qint32 operation, QByteArray data, QString error)
POD MountTreeDirectory(quint32 result, QList<MountTreeEntry> entries, QString error)

class ArchiveMount
{
    PROP(QList<MountTreeEntry> entries={} CONSTANT)
    PROP(QString user="" CONSTANT)
    PROP(QString password="" CONSTANT)
    PROP(QString share="Sevenzip" CONSTANT)
    SLOT(MountTreeRead read(quint64 id, quint64 offset, quint32 length))
    SLOT(MountTreeDirectory listDirectory(quint64 id))
    SLOT(void listening(quint16 port))
    SLOT(void failed(QString error))
}
